---
// A plain list of guides, one per row. Each row shows the guide's title and, optionally,
// its short description and which game it's for. Used on the homepage, game pages and
// under each guide.
import { getGuideGameId, getGuideUrl, type Game, type Guide } from '@/utils/content';

export interface Props {
  guides: Guide[];
  games: Game[];
  // Show which game each guide is for (homepage). Off on a game's own page.
  showGame?: boolean;
  // Show the guide's one-line description under the title.
  showDescription?: boolean;
}

const { guides, games, showGame = true, showDescription = false } = Astro.props;
const gamesById = new Map(games.map((game) => [game.id, game]));
---

<ul class="guide-list">
  {
    guides.map((guide) => {
      const game = gamesById.get(getGuideGameId(guide));
      return (
        <li>
          <a href={getGuideUrl(guide)} class="guide-row">
            <span class="title">
              {guide.data.title}
              {guide.data.draft && <span class="draft"> (draft)</span>}
            </span>
            {showGame && game && <span class="game">{game.data.name}</span>}
            {showDescription && <span class="description">{guide.data.description}</span>}
          </a>
        </li>
      );
    })
  }
</ul>

<style>
  .guide-list {
    list-style: none;
    padding: 0;
    border-top: 1px solid var(--color-border);
  }

  li {
    border-bottom: 1px solid var(--color-border);
  }

  .guide-row {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: baseline;
    gap: var(--space-1) var(--space-6);
    padding: var(--space-4) var(--space-2);
    text-decoration: none;
  }

  .guide-row:hover {
    background: var(--color-highlight);
  }

  .title {
    font-weight: 700;
    font-size: var(--text-lg);
    line-height: 1.35;
  }

  .game {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    white-space: nowrap;
  }

  .description {
    grid-column: 1 / -1;
    max-width: 44rem;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .guide-row:hover .game,
  .guide-row:hover .description {
    color: var(--color-text);
  }

  .draft {
    color: var(--color-warning);
    font-weight: 500;
  }
</style>
