---
// A bordered list of guides: title, "Game · Category" and the last updated date.
// Used on the homepage now, and on game hub pages later.
import {
  getCategoryLabel,
  getGuideDate,
  getGuideGameId,
  getGuideUrl,
  type Game,
  type Guide,
} from '@/utils/content';
import { formatDate, toIsoDate } from '@/utils/date';

export interface Props {
  guides: Guide[];
  games: Game[];
  // Hide the game name, e.g. on a game's own hub page.
  showGame?: boolean;
}

const { guides, games, showGame = true } = Astro.props;
const gamesById = new Map(games.map((game) => [game.id, game]));
---

<ul class="guide-list">
  {
    guides.map((guide) => {
      const game = gamesById.get(getGuideGameId(guide));
      const category = game ? getCategoryLabel(game, guide.data.category) : guide.data.category;
      const date = getGuideDate(guide);
      return (
        <li>
          <a href={getGuideUrl(guide)} class="guide-row">
            <div class="text">
              <span class="title">
                {guide.data.title}
                {guide.data.draft && <span class="draft">Draft</span>}
              </span>
              <span class="meta">{showGame && game ? `${game.data.name} · ${category}` : category}</span>
            </div>
            <span class="date">
              {guide.data.updatedAt ? 'Updated' : 'Published'} <time datetime={toIsoDate(date)}>{formatDate(date)}</time>
            </span>
          </a>
        </li>
      );
    })
  }
</ul>

<style>
  .guide-list {
    list-style: none;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: 14px;
    overflow: hidden;
    background: var(--color-surface);
  }

  li + li {
    border-top: 1px solid var(--color-border);
  }

  .guide-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
    padding: var(--space-4) var(--space-6);
    color: var(--color-text);
  }

  .guide-row:hover {
    background: var(--color-surface-2);
    color: var(--color-text);
    text-decoration: none;
  }

  .text {
    display: grid;
    gap: var(--space-1);
    min-width: 0;
  }

  .title {
    font-weight: 700;
  }

  .draft {
    margin-left: var(--space-2);
    padding: 0.1rem 0.45rem;
    border-radius: 6px;
    background: #3a2c10;
    color: var(--color-warning);
    font-size: 0.7rem;
    font-weight: 700;
    vertical-align: middle;
  }

  .meta,
  .date {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }
</style>
