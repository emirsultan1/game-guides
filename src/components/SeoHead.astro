---
// Everything that goes inside <head>: title, description, canonical URL,
// Open Graph and Twitter tags for link previews.
import { SITE } from '@/site.config';
import { cleanPath } from '@/utils/url';

export interface Props {
  title?: string;
  description?: string;
  image?: string | null;
  type?: 'website' | 'article';
  noindex?: boolean;
}

const {
  title,
  description = SITE.description,
  image = SITE.defaultOgImage,
  type = 'website',
  noindex = false,
} = Astro.props;

// "How to Make Money Fast | Game Guides", or just the site name on the homepage.
const fullTitle = title ? `${title} | ${SITE.name}` : `${SITE.name} — ${SITE.tagline}`;
const canonicalUrl = new URL(cleanPath(Astro.url.pathname), Astro.site);
const imageUrl = image ? new URL(image, Astro.site) : null;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

{
  SITE.googleSiteVerification && (
    <meta name="google-site-verification" content={SITE.googleSiteVerification} />
  )
}

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="theme-color" content="#0f1115" />

<!-- Open Graph (Facebook, Discord, WhatsApp, etc.) -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
{imageUrl && <meta property="og:image" content={imageUrl} />}
<meta property="og:locale" content={SITE.ogLocale} />

<!-- Twitter / X -->
<meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
{imageUrl && <meta name="twitter:image" content={imageUrl} />}
