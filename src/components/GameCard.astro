---
// A game tile for the homepage grid: cover art (or a placeholder), name, status and tagline.
// Games with guides link to their hub page. Teaser games (no guides yet) show a
// "Guides coming soon" card that isn't a link, because they have no hub page yet.
import StatusBadge from '@/components/StatusBadge.astro';
import { getGameUrl, type Game } from '@/utils/content';

export interface Props {
  game: Game;
  guideCount: number;
}

const { game, guideCount } = Astro.props;
const { name, tagline, status, cover } = game.data;
const isTeaser = guideCount === 0;
const Tag = isTeaser ? 'div' : 'a';
---

<Tag
  href={isTeaser ? undefined : getGameUrl(game)}
  class:list={['game-card', { teaser: isTeaser }]}
>
  {
    cover ? (
      <img src={cover} alt="" class="cover" width="1280" height="680" loading="lazy" decoding="async" />
    ) : (
      <div class="cover cover-placeholder" aria-hidden="true">
        {name}
      </div>
    )
  }
  <div class="body">
    <div class="title-row">
      <h3 class="name">{name}</h3>
      {isTeaser ? <span class="soon">Guides soon</span> : <StatusBadge status={status} />}
    </div>
    <p class="tagline">{tagline}</p>
    <p class="count">
      {isTeaser ? 'Guides coming soon' : `${guideCount} guide${guideCount === 1 ? '' : 's'}`}
    </p>
  </div>
</Tag>

<style>
  .game-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-border);
    border-radius: 14px;
    overflow: hidden;
    background: var(--color-surface);
    color: var(--color-text);
    transition:
      border-color 0.15s ease,
      transform 0.15s ease;
  }

  a.game-card:hover {
    border-color: var(--color-accent);
    color: var(--color-text);
    text-decoration: none;
    transform: translateY(-2px);
  }

  .teaser {
    border-style: dashed;
  }

  .cover {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 8.5;
    object-fit: cover;
  }

  .cover-placeholder {
    display: grid;
    place-items: center;
    background: var(--color-surface-2);
    color: var(--color-text-muted);
    font-size: var(--text-2xl);
    font-weight: 800;
    letter-spacing: -0.01em;
  }

  .body {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-4) var(--space-6);
  }

  .title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .name {
    font-size: var(--text-xl);
    font-weight: 800;
  }

  .soon {
    display: inline-block;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: #3a2c10;
    color: var(--color-warning);
    font-size: 0.75rem;
    font-weight: 700;
    white-space: nowrap;
  }

  .tagline {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .count {
    color: var(--color-text-muted);
    font-size: 0.8rem;
    font-weight: 600;
  }
</style>
