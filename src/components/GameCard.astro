---
// A big game tile for the homepage: the game's name, one line about it and how many guides it has.
// Games with guides link to their page. Teaser games (no guides yet) aren't links,
// because they don't have a page yet.
import { getGameUrl, type Game } from '@/utils/content';

export interface Props {
  game: Game;
  guideCount: number;
}

const { game, guideCount } = Astro.props;
const { name, tagline } = game.data;
const isTeaser = guideCount === 0;
const Tag = isTeaser ? 'div' : 'a';
---

<Tag href={isTeaser ? undefined : getGameUrl(game)} class:list={['game-tile', { teaser: isTeaser }]}>
  <span class="name">{name}</span>
  <span class="tagline">{tagline}</span>
  <span class="count">
    {isTeaser ? 'Guides coming soon' : guideCount === 1 ? '1 guide' : `${guideCount} guides`}
  </span>
</Tag>

<style>
  .game-tile {
    display: grid;
    align-content: start;
    gap: var(--space-2);
    padding: var(--space-6);
    border: 2px solid var(--color-text);
    border-radius: var(--radius);
    background: var(--color-surface);
    text-decoration: none;
  }

  a.game-tile:hover {
    background: var(--color-highlight);
  }

  .teaser {
    border-style: dashed;
    border-color: var(--color-text-muted);
    background: transparent;
  }

  .name {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 6vw, 3.25rem);
    font-weight: 700;
    line-height: 1;
  }

  .tagline {
    max-width: 30rem;
    color: var(--color-text-muted);
  }

  a.game-tile:hover .tagline {
    color: var(--color-text);
  }

  .count {
    margin-top: var(--space-2);
    font-weight: 700;
  }
</style>
