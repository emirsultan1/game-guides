---
import { SITE, NAV_LINKS } from '@/site.config';
import { cleanPath } from '@/utils/url';

const currentPath = cleanPath(Astro.url.pathname);
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="logo" aria-label={`${SITE.name} home`}>
      <img src="/favicon.svg" alt="" width="32" height="32" />
      <span>{SITE.name}</span>
    </a>

    <nav aria-label="Main">
      <ul class="nav-list">
        {
          NAV_LINKS.map((link) => (
            <li>
              <a
                href={link.href}
                class="nav-link"
                aria-current={link.href === currentPath ? 'page' : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
        <li>
          <a
            href="/search"
            class="nav-link search-link"
            aria-label="Search guides"
            aria-current={currentPath === '/search' ? 'page' : undefined}
          >
            <svg
              aria-hidden="true"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <circle cx="11" cy="11" r="7"></circle>
              <path d="m20 20-3.5-3.5"></path>
            </svg>
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--header-height);
    background: rgb(15 17 21 / 0.85);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--color-border);
  }

  .header-inner {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .logo {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-text);
    font-weight: 800;
    font-size: var(--text-lg);
    letter-spacing: -0.01em;
  }

  .logo:hover {
    color: var(--color-text);
    text-decoration: none;
  }

  .nav-list {
    display: flex;
    gap: var(--space-1);
    list-style: none;
    padding: 0;
  }

  .nav-link {
    display: block;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius);
    color: var(--color-text-muted);
    font-weight: 600;
    font-size: var(--text-sm);
  }

  .search-link {
    display: flex;
    align-items: center;
    min-height: 36px;
  }

  .nav-link:hover,
  .nav-link[aria-current='page'] {
    color: var(--color-text);
    background: var(--color-surface-2);
    text-decoration: none;
  }
</style>
