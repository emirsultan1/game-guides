---
// Site header: the name (text only), the main links and a search link.
// The icon in public/favicon.svg is only used as the browser-tab icon.
import { SITE, NAV_LINKS } from '@/site.config';
import { cleanPath } from '@/utils/url';

const currentPath = cleanPath(Astro.url.pathname);
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="wordmark">{SITE.name}</a>

    <nav aria-label="Main">
      <ul class="nav-list">
        {
          NAV_LINKS.map((link) => (
            <li>
              <a
                href={link.href}
                class="nav-link"
                aria-current={link.href === currentPath ? 'page' : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
        <li>
          <a href="/search" class="nav-link search-link" aria-current={currentPath === '/search' ? 'page' : undefined}>
            <svg
              aria-hidden="true"
              width="17"
              height="17"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.25"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <circle cx="11" cy="11" r="7"></circle>
              <path d="m20 20-3.5-3.5"></path>
            </svg>
            <span>Search</span>
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--header-height);
    background: var(--color-bg);
    border-bottom: 2px solid var(--color-text);
  }

  .header-inner {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .wordmark {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.01em;
    text-decoration: none;
  }

  .wordmark:hover {
    background: none;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    list-style: none;
    padding: 0;
  }

  .nav-link {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 40px;
    padding: 0 var(--space-3);
    font-weight: 500;
    text-decoration: none;
  }

  .nav-link[aria-current='page'] {
    text-decoration: underline;
    text-decoration-color: var(--color-highlight);
    text-decoration-thickness: 0.22em;
  }

  @media (max-width: 420px) {
    .search-link span {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
    }
  }
</style>
