---
import { SITE, NAV_LINKS, FOOTER_LINKS } from '@/site.config';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <a href="/" class="footer-name">{SITE.name}</a>
      <p class="footer-tagline">{SITE.tagline}</p>
    </div>

    <nav aria-label="Footer">
      <ul class="footer-links">
        {
          [...NAV_LINKS, ...FOOTER_LINKS].map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <div class="container footer-bottom">
    <p>
      © {year} {SITE.name}. An independent fan site, not affiliated with any game developer or publisher. Game names
      and trademarks belong to their owners.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-16);
    border-top: 2px solid var(--color-rule);
    font-size: var(--text-sm);
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-6);
    padding-block: var(--space-8) var(--space-6);
  }

  .footer-name {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 700;
    text-decoration: none;
  }

  .footer-tagline {
    margin-top: var(--space-1);
    color: var(--color-text-muted);
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    list-style: none;
    padding: 0;
  }

  .footer-bottom {
    padding-block: var(--space-4) var(--space-8);
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }

  .footer-bottom p {
    max-width: 44rem;
  }
</style>
