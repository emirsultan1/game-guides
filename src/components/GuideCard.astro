---
// A bigger guide tile with category, title and description.
// Used for the "Start here" (featured) guides on a game hub.
import { getGuideUrl, type Guide } from '@/utils/content';

export interface Props {
  guide: Guide;
  categoryLabel: string;
}

const { guide, categoryLabel } = Astro.props;
const { title, description, draft } = guide.data;
---

<a href={getGuideUrl(guide)} class="guide-card">
  <div class="tags">
    <span class="category">{categoryLabel}</span>
    {draft && <span class="draft">Draft</span>}
  </div>
  <h3 class="title">{title}</h3>
  <p class="description">{description}</p>
</a>

<style>
  .guide-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: 14px;
    background: var(--color-surface);
    color: var(--color-text);
    transition:
      border-color 0.15s ease,
      transform 0.15s ease;
  }

  .guide-card:hover {
    border-color: var(--color-accent);
    color: var(--color-text);
    text-decoration: none;
    transform: translateY(-2px);
  }

  .tags {
    display: flex;
    gap: var(--space-2);
  }

  .category,
  .draft {
    padding: 0.15rem 0.55rem;
    border-radius: 6px;
    font-size: 0.75rem;
    font-weight: 700;
  }

  .category {
    background: var(--color-surface-2);
    color: var(--color-text-muted);
  }

  .draft {
    background: #3a2c10;
    color: var(--color-warning);
  }

  .title {
    font-size: var(--text-lg);
    line-height: 1.35;
  }

  .description {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }
</style>
