---
// Layout for simple text pages like About, Contact and Privacy Policy:
// a title, an optional intro line, and readable content.
import BaseLayout from '@/layouts/BaseLayout.astro';

export interface Props {
  title: string;
  description: string;
  intro?: string;
  noindex?: boolean;
}

const { title, description, intro, noindex = false } = Astro.props;
---

<BaseLayout title={title} description={description} noindex={noindex}>
  <article class="container page">
    <header class="page-header">
      <h1>{title}</h1>
      {intro && <p class="intro">{intro}</p>}
    </header>
    <div class="page-content">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .page {
    max-width: calc(var(--content-width) + 2 * var(--space-6));
    display: grid;
    gap: var(--space-8);
  }

  .page-header {
    display: grid;
    gap: var(--space-3);
  }

  .page-header h1 {
    font-size: clamp(2.5rem, 7vw, 3.75rem);
    line-height: 1;
  }

  .intro {
    font-size: var(--text-lg);
  }

  .page-content {
    display: grid;
    gap: var(--space-4);
    font-size: var(--text-lg);
    line-height: 1.7;
  }

  .page-content :global(h2) {
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    border-top: 2px solid var(--color-rule);
  }

  .page-content :global(ul) {
    display: grid;
    gap: var(--space-2);
    padding-left: var(--space-6);
  }
</style>
