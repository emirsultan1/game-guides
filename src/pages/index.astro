---
import BaseLayout from '@/layouts/BaseLayout.astro';
import GameCard from '@/components/GameCard.astro';
import GuideList from '@/components/GuideList.astro';
import JsonLd from '@/components/JsonLd.astro';
import SearchForm from '@/components/SearchForm.astro';
import { SITE } from '@/site.config';
import { getActiveGames, getGuides, getGuideGameId, getTeaserGames } from '@/utils/content';
import { websiteSchema } from '@/utils/schema';

const START_GUIDES_PER_GAME = 3;

const [games, teaserGames, guides] = await Promise.all([getActiveGames(), getTeaserGames(), getGuides()]);

// Games with guides first, then "coming soon" teasers, each group in `order`.
const gameCards = [...games, ...teaserGames];

// How many guides each game has, for the game tiles.
const guideCounts = new Map<string, number>();
for (const guide of guides) {
  const gameId = getGuideGameId(guide);
  guideCounts.set(gameId, (guideCounts.get(gameId) ?? 0) + 1);
}

// "Good places to start": each game's featured guides, in game order.
const startGuides = games.flatMap((game) =>
  guides
    .filter((guide) => getGuideGameId(guide) === game.id && guide.data.featured)
    .slice(0, START_GUIDES_PER_GAME),
);
---

<BaseLayout>
  <JsonLd slot="head" data={websiteSchema(Astro.site!)} />

  <section class="container hero">
    <h1>{SITE.tagline}</h1>
    <p class="lead">Stuck on something? Search for it, or pick a game below.</p>
    <SearchForm id="hero-search-input" />
  </section>

  <section id="games" class="container section" aria-labelledby="games-heading">
    <h2 id="games-heading">Pick a game</h2>
    {
      gameCards.length > 0 ? (
        <div class="game-grid">
          {gameCards.map((game) => (
            <GameCard game={game} guideCount={guideCounts.get(game.id) ?? 0} />
          ))}
        </div>
      ) : (
        <p class="empty">The first guides are on the way. Check back soon.</p>
      )
    }
  </section>

  {
    startGuides.length > 0 && (
      <section class="container section" aria-labelledby="start-heading">
        <h2 id="start-heading">Good places to start</h2>
        <GuideList guides={startGuides} games={games} />
      </section>
    )
  }
</BaseLayout>

<style>
  .hero {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-8) var(--space-12);
  }

  .hero h1 {
    max-width: 14ch;
    font-size: clamp(3rem, 9vw, 5.5rem);
    line-height: 0.95;
  }

  .lead {
    max-width: 34rem;
    margin-top: var(--space-2);
    margin-bottom: var(--space-2);
    font-size: var(--text-lg);
  }

  .section {
    display: grid;
    gap: var(--space-6);
    padding-block: var(--space-8);
  }

  .game-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr));
    gap: var(--space-6);
  }

  .empty {
    color: var(--color-text-muted);
  }
</style>
