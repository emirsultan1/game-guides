---
import PageLayout from '@/layouts/PageLayout.astro';
import { SITE } from '@/site.config';
---

<PageLayout
  title="Contact"
  description={`How to contact ${SITE.name}: report a mistake in a guide, suggest a guide, or get in touch about anything else.`}
  intro="Found a mistake, want a guide on something, or just want to say hi?"
>
  {
    SITE.contactEmail ? (
      <p>
        Email us at <a href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a>. We read every message.
      </p>
    ) : (
      <p>A contact email is coming soon.</p>
    )
  }

  <h2>Reporting a mistake</h2>
  <p>Games change fast, and guides can go out of date. If something is wrong, please include:</p>
  <ul>
    <li>The link to the guide</li>
    <li>What’s wrong, and what it should say</li>
    <li>The game version or patch, if you know it</li>
  </ul>

  <h2>Suggesting a guide</h2>
  <p>Tell us the game and the question you couldn’t find an answer to. Those make the best guides.</p>

  <h2>Business enquiries</h2>
  <p>For partnerships or advertising, use the same email and put “Business” in the subject line.</p>
</PageLayout>
