---
// Guide page, one per guide: /rob-run/first-hour-in-looty-bay
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import TableOfContents from '@/components/TableOfContents.astro';
import GuideList from '@/components/GuideList.astro';
import JsonLd from '@/components/JsonLd.astro';
import {
  getGames,
  getGuides,
  getGuideGameId,
  getGuideSlug,
  getGameUrl,
  getCategoryLabel,
  getGuideUrl,
  type Game,
  type Guide,
} from '@/utils/content';
import { formatDate, toIsoDate } from '@/utils/date';
import { breadcrumbSchema, guideSchema } from '@/utils/schema';

export const getStaticPaths = (async () => {
  // Constants used here must live inside getStaticPaths: Astro runs it on its own.
  const RELATED_GUIDES_COUNT = 4;
  const [games, guides] = await Promise.all([getGames(), getGuides()]);
  const gamesById = new Map(games.map((game) => [game.id, game]));

  return guides.map((guide) => {
    const game = gamesById.get(getGuideGameId(guide))!;
    const otherGuides = guides.filter((g) => g.id !== guide.id && getGuideGameId(g) === game.id);
    // Same topic first, then the rest of the game's guides (both newest first).
    const related = [
      ...otherGuides.filter((g) => g.data.category === guide.data.category),
      ...otherGuides.filter((g) => g.data.category !== guide.data.category),
    ].slice(0, RELATED_GUIDES_COUNT);

    return {
      params: { game: game.id, slug: getGuideSlug(guide) },
      props: { guide, game, related },
    };
  });
}) satisfies GetStaticPaths;

interface Props {
  guide: Guide;
  game: Game;
  related: Guide[];
}

const { guide, game, related } = Astro.props;
const {
  title,
  description,
  category,
  quickAnswer,
  publishedAt,
  updatedAt,
  gameVersion,
  author,
  draft,
  image,
  imageAlt,
} = guide.data;
const { Content, headings } = await render(guide);

const categoryLabel = getCategoryLabel(game, category);
// Link previews use the guide's image, then the game's cover, then the site default.
const gameUrl = getGameUrl(game);
---

<BaseLayout
  title={title}
  description={description}
  type="article"
  noindex={draft}
  image={image ?? game.data.cover}
>
  <JsonLd
    slot="head"
    data={[
      guideSchema(guide, game, Astro.site!),
      breadcrumbSchema(
        [
          { name: 'Home', path: '/' },
          { name: game.data.name, path: gameUrl },
          { name: title, path: getGuideUrl(guide) },
        ],
        Astro.site!,
      ),
    ]}
  />
  <div class="container guide-layout">
    <article class="guide">
      <header class="guide-header">
        <Breadcrumbs
          items={[
            { label: 'Home', href: '/' },
            { label: game.data.name, href: gameUrl },
            { label: categoryLabel, href: `${gameUrl}#${category}` },
          ]}
        />

        {draft && <p class="draft">Draft: only visible in npm run dev, not on the live site.</p>}

        <h1>{title}</h1>
        <p class="lead">{description}</p>

        <p class="meta">
          By <a href="/about">{author}</a>, {updatedAt ? 'updated' : 'published'}{' '}
          <time datetime={toIsoDate(updatedAt ?? publishedAt)}>{formatDate(updatedAt ?? publishedAt)}</time>
          {gameVersion && <span>, checked on version {gameVersion}</span>}
        </p>
      </header>

      {
        image && (
          <img src={image} alt={imageAlt ?? title} class="hero-image" width="1280" height="720" />
        )
      }

      {
        quickAnswer && (
          <section class="quick-answer" aria-labelledby="quick-answer-heading">
            <h2 id="quick-answer-heading">Short answer</h2>
            <p>
              <mark>{quickAnswer}</mark>
            </p>
          </section>
        )
      }

      <div class="toc-mobile">
        <TableOfContents headings={headings} collapsible />
      </div>

      <div class="prose">
        <Content />
      </div>

      {
        related.length > 0 && (
          <section class="related" aria-labelledby="related-heading">
            <h2 id="related-heading">More {game.data.name} guides</h2>
            <GuideList guides={related} games={[game]} showGame={false} />
            <p>
              <a href={gameUrl} class="all-link">
                See all {game.data.name} guides
              </a>
            </p>
          </section>
        )
      }
    </article>

    <aside class="sidebar">
      <div class="sidebar-inner">
        <TableOfContents headings={headings} />
      </div>
    </aside>
  </div>

  <dialog class="lightbox" aria-label="Screenshot">
    <img src="" alt="" />
    <div class="lightbox-bar">
      <span class="lightbox-caption"></span>
      <button type="button" class="lightbox-close">Close</button>
    </div>
  </dialog>
</BaseLayout>

<script>
  // Click a screenshot to see it full size. Click anywhere or press Esc to close.
  const dialog = document.querySelector<HTMLDialogElement>('.lightbox');
  const big = dialog?.querySelector('img');
  const caption = dialog?.querySelector('.lightbox-caption');

  if (dialog && big && caption) {
    document.querySelectorAll<HTMLImageElement>('.prose .guide-figure img').forEach((img) => {
      img.addEventListener('click', () => {
        big.src = img.currentSrc || img.src;
        big.alt = img.alt;
        caption.textContent = img.closest('figure')?.querySelector('figcaption')?.textContent ?? img.alt;
        dialog.showModal();
      });
    });
    dialog.addEventListener('click', () => dialog.close());
  }
</script>

<style>
  .guide-layout {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: var(--space-12);
  }

  .guide {
    flex: 999 1 34rem;
    min-width: 0;
    max-width: var(--content-width);
    display: grid;
    gap: var(--space-8);
  }

  .sidebar {
    flex: 1 1 14rem;
    min-width: 0;
    align-self: stretch;
    padding-top: var(--space-12);
  }

  .sidebar-inner {
    position: sticky;
    top: calc(var(--header-height) + var(--space-6));
  }

  /* --- Header ------------------------------------------------------------- */

  .guide-header {
    display: grid;
    gap: var(--space-4);
  }

  .guide-header h1 {
    font-size: clamp(2.25rem, 6vw, 3.25rem);
    line-height: 1;
  }

  .lead {
    font-size: var(--text-lg);
  }

  .meta {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .draft {
    justify-self: start;
    padding: var(--space-1) var(--space-3);
    background: var(--color-highlight-soft);
    color: var(--color-warning);
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .hero-image {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border: 2px solid var(--color-text);
  }

  /* --- Short answer: the highlighted bit -------------------------------- */

  .quick-answer {
    display: grid;
    gap: var(--space-2);
    padding-left: var(--space-4);
    border-left: 4px solid var(--color-text);
  }

  .quick-answer h2 {
    font-family: var(--font-sans);
    font-size: var(--text-base);
    font-weight: 700;
  }

  .quick-answer p {
    font-size: var(--text-lg);
    line-height: 1.7;
  }

  /* A highlighter stroke behind each line of the answer */
  .quick-answer mark {
    padding: 0.08em 0.15em;
    background: var(--color-highlight);
    color: var(--color-text);
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }

  /* --- Guide content (rendered from Markdown) ----------------------------- */

  .prose {
    display: grid;
    gap: var(--space-4);
    font-size: var(--text-lg);
    line-height: 1.7;
  }

  .prose :global(h2) {
    margin-top: var(--space-8);
    padding-top: var(--space-4);
    border-top: 2px solid var(--color-text);
  }

  .prose :global(h3) {
    margin-top: var(--space-4);
  }

  .prose :global(ul),
  .prose :global(ol) {
    display: grid;
    gap: var(--space-2);
    padding-left: var(--space-6);
  }

  .prose :global(li::marker) {
    font-weight: 700;
  }

  /* Tips and warnings (Markdown "> ..." quotes) */
  .prose :global(blockquote) {
    padding: var(--space-4) var(--space-6);
    background: var(--color-highlight-soft);
    border-left: 4px solid var(--color-text);
  }

  .prose :global(img) {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
    border: 2px solid var(--color-text);
    background: var(--color-surface);
  }

  /* Screenshots: one per line becomes a captioned figure (see src/plugins/guide-media.mjs). */
  .prose :global(.guide-figure) {
    display: grid;
    gap: var(--space-2);
    margin: var(--space-2) 0;
  }

  .prose :global(.guide-figure img) {
    cursor: zoom-in;
  }

  .prose :global(figcaption) {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: 1.5;
  }

  /* Two or three screenshots on consecutive lines sit side by side. */
  .prose :global(.guide-gallery) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: var(--space-4);
    align-items: start;
  }

  .prose :global(.guide-gallery .guide-figure) {
    margin: 0;
  }

  .prose :global(.guide-gallery img) {
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  /* [SCREENSHOT: ...] notes. Only shown in `npm run dev`. */
  .prose :global(.screenshot-needed) {
    display: grid;
    place-content: center;
    gap: var(--space-1);
    min-height: clamp(9rem, 38vw, 18rem);
    padding: var(--space-6);
    border: 2px dashed var(--color-text-muted);
    background: repeating-linear-gradient(-45deg, var(--color-bg) 0 14px, var(--color-surface-2) 14px 28px);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    text-align: center;
  }

  .prose :global(.screenshot-needed strong) {
    color: var(--color-text);
    font-size: var(--text-base);
  }

  .prose :global(table) {
    display: block;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: var(--text-sm);
    line-height: 1.5;
    background: var(--color-surface);
  }

  .prose :global(th),
  .prose :global(td) {
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-border);
    text-align: left;
    vertical-align: top;
  }

  .prose :global(th) {
    border-bottom: 2px solid var(--color-text);
    white-space: nowrap;
  }

  .prose :global(hr) {
    border: 0;
    border-top: 1px solid var(--color-border);
  }

  /* Full-size screenshot viewer */
  .lightbox {
    margin: auto;
    width: min(96vw, 1600px);
    max-width: none;
    max-height: 94vh;
    padding: 0;
    border: 2px solid var(--color-text);
    background: var(--color-bg);
    color: var(--color-text);
  }

  .lightbox::backdrop {
    background: rgb(22 24 27 / 0.88);
  }

  .lightbox img {
    display: block;
    width: 100%;
    max-height: calc(94vh - 3.5rem);
    object-fit: contain;
  }

  .lightbox-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-4);
    font-size: var(--text-sm);
  }

  .lightbox-caption {
    color: var(--color-text-muted);
  }

  .lightbox-close {
    padding: var(--space-1) var(--space-3);
    border: 2px solid var(--color-text);
    border-radius: var(--radius);
    background: var(--color-surface);
    color: var(--color-text);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }

  /* --- More guides -------------------------------------------------------- */

  .related {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-4);
  }

  .all-link {
    font-weight: 700;
  }

  /* The table of contents sits in the sidebar on wide screens,
     and as a tap-to-open line above the guide on phones and tablets. */
  .toc-mobile {
    display: none;
  }

  @media (max-width: 900px) {
    .sidebar {
      display: none;
    }

    .toc-mobile {
      display: block;
    }

    .toc-mobile:empty {
      display: none;
    }
  }
</style>
