---
// Game page, one per game: /rob-run, /gta-6, ...
// A short intro, then "Start here" (featured guides), then every other guide grouped by topic.
// Each guide appears exactly once on the page.
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import GuideList from '@/components/GuideList.astro';
import JsonLd from '@/components/JsonLd.astro';
import { getGamesWithGuides, getGuidesForGame, getGameUrl, type Game } from '@/utils/content';
import { breadcrumbSchema, gameHubSchema } from '@/utils/schema';

export const getStaticPaths = (async () => {
  // Only games with guides get a page, so there are no empty pages for Google to find.
  const games = await getGamesWithGuides();
  return games.map((game) => ({ params: { game: game.id }, props: { game } }));
}) satisfies GetStaticPaths;

interface Props {
  game: Game;
}

const { game } = Astro.props;
const { name, description, categories, cover } = game.data;

const guides = await getGuidesForGame(game.id);
const featuredGuides = guides.filter((guide) => guide.data.featured).slice(0, 3);
const featuredIds = new Set(featuredGuides.map((guide) => guide.id));

// Topics in the order the game file lists them, without the guides already in "Start here".
// Topics left with no guides are skipped.
const sections = categories
  .map((category) => ({
    ...category,
    guides: guides.filter((guide) => guide.data.category === category.id && !featuredIds.has(guide.id)),
  }))
  .filter((section) => section.guides.length > 0);
---

<BaseLayout title={`${name} Guides`} description={description} image={cover}>
  <JsonLd
    slot="head"
    data={[
      gameHubSchema(game, guides.filter((guide) => !guide.data.draft), Astro.site!),
      breadcrumbSchema(
        [
          { name: 'Home', path: '/' },
          { name, path: getGameUrl(game) },
        ],
        Astro.site!,
      ),
    ]}
  />

  <div class="container hub">
    <header class="hub-header">
      <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: name }]} />
      <h1>{name} guides</h1>
      <p class="description">{description}</p>
      {
        sections.length > 1 && (
          <nav class="jump" aria-label={`${name} topics`}>
            <span class="jump-label">Jump to</span>
            <ul>
              {sections.map((section) => (
                <li>
                  <a href={`#${section.id}`}>{section.label}</a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }
    </header>

    {
      featuredGuides.length > 0 && (
        <section class="section" aria-labelledby="start-here">
          <h2 id="start-here">Start here</h2>
          <GuideList guides={featuredGuides} games={[game]} showGame={false} showDescription />
        </section>
      )
    }

    {
      sections.map((section) => (
        <section id={section.id} class="section" aria-labelledby={`${section.id}-heading`}>
          <h2 id={`${section.id}-heading`}>{section.label}</h2>
          <GuideList guides={section.guides} games={[game]} showGame={false} />
        </section>
      ))
    }
  </div>
</BaseLayout>

<style>
  .hub {
    display: grid;
    gap: var(--space-8);
  }

  .hub-header {
    display: grid;
    gap: var(--space-4);
    padding-bottom: var(--space-2);
  }

  .hub-header h1 {
    font-size: clamp(2.75rem, 8vw, 4.5rem);
    line-height: 0.95;
  }

  .description {
    max-width: 38rem;
    font-size: var(--text-lg);
  }

  .jump {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-4);
    font-size: var(--text-sm);
  }

  .jump-label {
    color: var(--color-text-muted);
  }

  .jump ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    list-style: none;
    padding: 0;
  }

  .jump a {
    font-weight: 500;
  }

  .section {
    display: grid;
    gap: var(--space-4);
  }
</style>
