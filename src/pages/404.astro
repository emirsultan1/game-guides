---
// Shown for any URL that doesn't exist. Hidden from search engines.
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getActiveGames, getGameUrl } from '@/utils/content';

const games = await getActiveGames();
---

<BaseLayout title="Page not found" description="This page doesn't exist." noindex>
  <section class="container not-found">
    <p class="code">404</p>
    <h1>This page doesn't exist</h1>
    <p class="text">The guide may have moved, or the link has a typo. Try one of these instead:</p>
    <ul class="links">
      <li><a href="/" class="button">Homepage</a></li>
      {
        games.map((game) => (
          <li>
            <a href={getGameUrl(game)} class="button">
              {game.data.name} guides
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<style>
  .not-found {
    display: grid;
    justify-items: center;
    gap: var(--space-4);
    padding-block: var(--space-16);
    text-align: center;
  }

  .code {
    color: var(--color-accent);
    font-size: var(--text-3xl);
    font-weight: 800;
  }

  .text {
    max-width: 32rem;
    color: var(--color-text-muted);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    list-style: none;
    padding: 0;
    margin-top: var(--space-2);
  }

  .button {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    color: var(--color-text);
    font-weight: 600;
  }

  .button:hover {
    border-color: var(--color-accent);
    color: var(--color-text);
    text-decoration: none;
  }
</style>
