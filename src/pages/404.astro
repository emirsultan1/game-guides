---
// Shown for any URL that doesn't exist. Hidden from search engines.
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getActiveGames, getGameUrl } from '@/utils/content';

const games = await getActiveGames();
---

<BaseLayout title="Page not found" description="This page doesn't exist." noindex>
  <section class="container not-found">
        <h1>This page doesn't exist</h1>
    <p class="text">The guide may have moved, or the link has a typo. Try one of these instead:</p>
    <ul class="links">
      <li><a href="/" class="button">Homepage</a></li>
      {
        games.map((game) => (
          <li>
            <a href={getGameUrl(game)} class="button">
              {game.data.name} guides
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<style>
  .not-found {
    display: grid;
    justify-items: start;
    gap: var(--space-4);
    padding-block: var(--space-12);
  }

  .not-found h1 {
    font-size: clamp(2.5rem, 7vw, 3.75rem);
    line-height: 1;
  }

  .text {
    max-width: 32rem;
    font-size: var(--text-lg);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    list-style: none;
    padding: 0;
    margin-top: var(--space-2);
  }

  .button {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0 var(--space-6);
    border: 2px solid var(--color-text);
    border-radius: var(--radius);
    background: var(--color-surface);
    font-weight: 700;
    text-decoration: none;
  }

  .button:hover {
    background: var(--color-highlight);
  }
</style>
